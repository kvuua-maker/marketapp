# ── Server ─────────────────────────────────────────────────────────────
PORT=8899
NODE_ENV=production

# Retail price = supplier wholesale price × (1 + MARGIN_PERCENT)
MARGIN_PERCENT=15
PRICE_ROUNDING=x9

# Sync cadence (minutes) and safety caps
SYNC_INTERVAL_MINUTES=90
SYNC_STALE_AFTER_MINUTES=180
MAX_PRODUCTS_PER_SYNC=8000
SYNC_PAGE_SIZE=100

# ── AI ─────────────────────────────────────────────────────────────────
# Without a key the pipeline still works, but titles stay in the supplier
# language (ai_status = "fallback"). With a key DeepSeek localises to Ukrainian.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BATCH_SIZE=12

# ── Suppliers ──────────────────────────────────────────────────────────
AVEPTO_ENABLED=true
AVEPTO_BASE_URL=https://www.aveopt.com.ua

LUGI_ENABLED=false
LUGI_API_BASE=
LUGI_COMPANY_ID=
LUGI_COMPANY_SECRET=

ZAKUPUS_ENABLED=false
ZAKUPUS_XML_URL=
ZAKUPUS_XML_PATH=

# ── Orders ─────────────────────────────────────────────────────────────
# outbox = store supplier emails in SQLite (safe default)
# resend = actually send them through https://resend.com
EMAIL_PROVIDER=outbox
EMAIL_FROM=orders@marketapp.example
RESEND_API_KEY=
AVEPTO_ORDER_EMAIL=orders@aveopt.example
ZAKUPUS_ORDER_EMAIL=zakupusb2b@gmail.com

# Optional bearer token for POST /v1/internal/sync
INTERNAL_TOKEN=

# ── Image proxy ────────────────────────────────────────────────────────
IMAGE_ALLOWED_HOSTS=www.aveopt.com.ua,aveopt.com.ua

# ── Nova Poshta waybills (optional; orders work without it) ────────────
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_SENDER=
NOVA_POSHTA_CONTACT=
NOVA_POSHTA_PHONE=
NOVA_POSHTA_CITY=
NOVA_POSHTA_WAREHOUSE=
