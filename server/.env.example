ADMIN_TOKEN=change-me
APPLE_CLIENT_ID=com.kvuua.marketapp

# Aveopt: api (default) or xml (YML price list)
AVEPTO_SOURCE=api
AVEPTO_XML_URL=

# Telegram sync notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dropt (second supplier, daily Prom/YML export)
DROPT_ENABLED=true
DROPT_XML_URL=https://dropt.in.ua/index.php?route=export/prom&markup=0&ids=uniq
DROPT_MARGIN_PERCENT=25
DROPT_SYNC_INTERVAL_MINUTES=1440
DROPT_ID_PREFIX=dropt_

# Dynamic pricing (competitor-based)
DYNAMIC_PRICING_ENABLED=true
PRICING_DRY_RUN=false
DYNAMIC_FLOOR_MARGIN_PERCENT=15
DYNAMIC_UNDERCUT_PERCENT=2
DYNAMIC_MAX_MARGIN_PERCENT=50
DYNAMIC_MAX_DAILY_CHANGE_PERCENT=30
DYNAMIC_PRICING_MAX_PRODUCTS=300
DYNAMIC_PRICING_INTERVAL_MINUTES=1440
DYNAMIC_PRICING_SOURCES=prom,hotline
DYNAMIC_PRICING_DELAY_MS=400

# Dropt payout register
PAYOUT_REPORT_ENABLED=true
DROPT_PAYOUT_HOLD_DAYS=14
