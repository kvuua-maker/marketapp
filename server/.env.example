ADMIN_TOKEN=change-me
APPLE_CLIENT_ID=com.kvuua.marketapp

# Aveopt: api (default) or xml (YML price list)
AVEPTO_SOURCE=api
AVEPTO_XML_URL=

# Telegram sync notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dropt (second supplier, daily Prom/YML export)
DROPT_ENABLED=true
DROPT_XML_URL=https://dropt.in.ua/index.php?route=export/prom&markup=0&ids=uniq
DROPT_MARGIN_PERCENT=15
DROPT_SYNC_INTERVAL_MINUTES=1440
DROPT_ID_PREFIX=dropt_
